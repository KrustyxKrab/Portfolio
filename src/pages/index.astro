---
import Layout from "@/layouts/Layout.astro";
import HeroCard from "@/components/home/HeroCard.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import Button from "@/components/ui/Button.astro";
import Arbeit from "@/components/sections/Arbeit.astro";
import Leistungen from "@/components/sections/Leistungen.astro";
import UeberMich from "@/components/sections/UeberMich.astro";
import Kontakt from "@/components/sections/Kontakt.astro";
---

<Layout
  title="Silas Kruckenberg — Dokumentation & Corporate Video"
  description="Authentisches Storytelling für Documentary & Corporate Video. Silas Kruckenberg bringt deine Geschichte auf die Leinwand."
  keywords="Documentary, Corporate Video, Storytelling, Videoproduktion, Deutschland"
>
  <!-- Hero -->
  <div class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-20 xl:px-0">
    <div class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-16">

      <!-- Left: text + button -->
      <div class="relative w-full md:max-w-[420px] md:w-1/2 text-center sm:text-left sm:-mt-8">
        <h1 class="mb-4">
          <AnimatedText
            content="Hi, Ich bin Silas"
            delay={0.1}
            duration={0.5}
            stagger={0.08}
            class="text-5xl text-neutral-900 leading-tight md:text-4xl lg:text-6xl"
          />
        </h1>

        <div class="mb-2">
          <AnimatedText
            content="Videograf und Dokumentarfilmer aus Deutschland. Ich begleite Menschen mit der Kamera — in Fabrikhallen, auf Feldern, in Büros, in ihren Wohnzimmern."
            delay={0.3}
            duration={0.5}
            stagger={0.015}
            class="text-base text-neutral-700"
          />
        </div>

        <div class="mb-4">
          <AnimatedText
            content="Was mich antreibt: der Moment, in dem Kamera und Mensch sich vergessen. Wenn eine Geschichte einfach passiert — ungeplant, ungestellt, wahr."
            delay={0.5}
            duration={0.5}
            stagger={0.015}
            class="text-base text-neutral-700"
          />
        </div>

        <div>
          <Button url="/#arbeit" type="fill" className="m-auto mt-4 text-center sm:text-left sm:m-0 sm:mt-6 max-w-[200px]">
            Meine Arbeit ↓
          </Button>
        </div>
      </div>

      <!-- Right: Silas photo card -->
      <div class="relative justify-end w-full mt-16 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0">
        <HeroCard
          imageUrl="/assets/Silas LinkedIn-1.jpg"
          title="Silas Kruckenberg"
          link="/#arbeit"
        />
      </div>
    </div>
  </div>

  <!-- Sections -->
  <Arbeit />
  <Leistungen />
  <UeberMich />
  <Kontakt />
</Layout>
