---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 – Seite nicht gefunden" description="Diese Seite existiert nicht.">
  <section style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--color-bg-primary-dark); padding: 2rem;">
    <h1 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(5rem, 20vw, 14rem); color: var(--color-rust); line-height: 1; margin: 0;">404</h1>
    <p style="font-family: var(--font-body); font-size: 1.1rem; color: var(--color-cream); margin: 1.5rem 0 2.5rem; opacity: 0.7;">Diese Seite gibt es nicht.</p>
    <a href="/" style="font-family: var(--font-heading); font-weight: 700; font-size: 1rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-cream); text-decoration: none; border-bottom: 2px solid var(--color-rust); padding-bottom: 2px;">Zurück zur Startseite</a>
  </section>
</Layout>
