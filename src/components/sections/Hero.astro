---
const phrases = [
  "Deine Geschichte.",
  "Authentisch.",
  "Dokumentarisch.",
  "Corporate Video.",
  "Auf die Leinwand.",
  "Mit Herz gemacht.",
];
---

<section class="hero">

  <img class="hero-bg" src="/hero-bg.png" alt="" aria-hidden="true" fetchpriority="high" />

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-text" aria-live="polite">
    <h1 class="hero-headline" id="hero-phrase"></h1>
  </div>

  <div class="mic-wrap" aria-hidden="true">
    <img class="mic-img" src="/assets/Mikro.png" alt="" fetchpriority="high" />
  </div>

  <div class="scroll-hint" id="scroll-hint" aria-hidden="true">
    <span class="scroll-text">Scroll</span>
    <svg class="scroll-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7" />
    </svg>
  </div>

</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, 0.1) 60%,
      rgba(13, 13, 13, 0.9) 100%
    );
  }

  /* Text — z-index 2, hinter dem Mikro */
  .hero-text {
    position: absolute;
    top: 20%;
    left: 0;
    right: 0;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
  }

  .hero-headline {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(3.5rem, 9vw, 9rem);
    line-height: 1;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: 0.02em;
    transition: opacity 0.4s ease;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }

  .hero-headline.fade-out {
    opacity: 0;
  }

  /* Mikro — z-index 3, vor dem Text */
  .mic-wrap {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    pointer-events: none;
  }

  .mic-img {
    height: 80vh;
    width: auto;
    display: block;
    transform: translateY(5%);
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, 0.5));
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
  }

  @media (max-width: 768px) {
    .hero-text {
      top: 12%;
    }
    .mic-img {
      height: 60vh;
    }
  }

  /* Scroll-Hinweis — z-index 4, über allem */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    transition: opacity 0.4s ease;
  }

  .scroll-hint.hidden-hint {
    opacity: 0;
    pointer-events: none;
  }

  .scroll-text {
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-cream);
    opacity: 0.6;
  }

  .scroll-arrow {
    width: 18px;
    height: 18px;
    color: var(--color-cream);
    opacity: 0.6;
    animation: bounce 1.8s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }
</style>

<script is:inline define:vars={{ phrases }}>
  const el = document.getElementById('hero-phrase');
  let idx = 0;

  if (el) {
    el.textContent = phrases[0];
    setInterval(() => {
      el.classList.add('fade-out');
      setTimeout(() => {
        idx = (idx + 1) % phrases.length;
        el.textContent = phrases[idx];
        el.classList.remove('fade-out');
      }, 400);
    }, 3000);
  }

  const hint = document.getElementById('scroll-hint');
  window.addEventListener('scroll', () => {
    if (!hint) return;
    hint.classList.toggle('hidden-hint', window.scrollY > 80);
  }, { passive: true });
</script>
