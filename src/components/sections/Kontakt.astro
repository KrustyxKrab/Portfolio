---
---

<section id="kontakt" class="kontakt-section">
  <div class="site-container">
    <div class="kontakt-inner">
      <h2 class="section-title">Lass uns<br />reden.</h2>
      <p class="kontakt-sub">
        Du hast ein Projekt, eine Idee oder einfach eine Frage?<br />
        Ich freue mich auf deine Nachricht.
      </p>

      <!-- Scrape-proof email -->
      <div class="email-wrap">
        <button class="email-btn" id="email-btn" aria-label="E-Mail an Silas Kruckenberg senden">
          <!-- aria-hidden decoys for bots -->
          <span aria-hidden="true" class="decoy">kontakt</span><!--
          --><span id="email-display"></span><!--
          --><span aria-hidden="true" class="decoy">@example.com</span>
        </button>
        <span class="email-hint">Klicken zum Schreiben</span>
      </div>

      <!-- Social links -->
      <div class="social-links">
        <a href="#" class="social-link" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          Instagram
        </a>
        <a href="https://www.linkedin.com/in/silas-johannes-kruckenberg/" class="social-link" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .kontakt-section {
    background: var(--color-bg-secondary);
    padding: 7rem 0 6rem;
  }

  .kontakt-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .section-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(3.5rem, 9vw, 7rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    line-height: 0.95;
    margin: 0 0 1.5rem;
  }

  .kontakt-sub {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 3rem;
  }

  /* Email */
  .email-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .decoy {
    display: none;
  }

  .email-btn {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.2rem, 4vw, 1.8rem);
    letter-spacing: 0.05em;
    text-transform: lowercase;
    color: var(--color-rust);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    transition: border-color 0.2s ease, color 0.2s ease;
    line-height: 1.2;
  }

  .email-btn:hover {
    border-color: var(--color-rust);
    color: var(--color-rust-dark);
  }

  .email-hint {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    opacity: 0.55;
  }

  /* Social links */
  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-rust);
  }

  .social-link svg {
    width: 18px;
    height: 18px;
  }
</style>

<script>
  // Scrape-proof email assembly
  const btn = document.getElementById('email-btn');
  const display = document.getElementById('email-display');

  const parts = ['silas', '@', 'kruckenbg', '.', 'de'];
  const email = parts.join('');

  if (display) {
    display.textContent = email;
  }

  if (btn) {
    btn.addEventListener('click', () => {
      window.location.href = 'mailto:' + email;
    });
  }
</script>
