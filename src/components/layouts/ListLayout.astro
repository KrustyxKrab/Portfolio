---
import { getCollection, render } from 'astro:content';
import { iconSrc } from '../../lib/icons';
import type { Locale } from '../../lib/i18n';
interface Entry {
  heading: string;
  subheading?: string;
  date?: string;
  detail?: string;
  body?: string;
  icon?: string;
  href?: string;
  note?: string;
}
interface Props { entries: Entry[]; locale?: Locale }
const { entries, locale = 'de' } = Astro.props;
const notes = new Map((entries.some(entry => entry.note) ? await getCollection('careerNotes', entry =>
  !entry.data.draft && Boolean(entry.body?.replace(/<!--[\s\S]*?-->/g, '').trim())
) : []).map(note => [note.id, note]));
const timeline = await Promise.all(entries.map(async entry => {
  const note = entry.note && (notes.get(`${locale}/${entry.note}`) ?? (locale === 'en' ? notes.get(`de/${entry.note}`) : undefined));
  return {
    ...entry,
    personalNote: note ? { Content: (await render(note)).Content, locale: note.id.startsWith('en/') ? 'en' : 'de' } : undefined,
  };
}));
---
<ol class="win-list career-timeline" role="list">
  {timeline.map(entry => {
    const NoteContent = entry.personalNote?.Content;
    return <li class="timeline-entry">
    <img class="timeline-icon" src={iconSrc(entry.icon ?? 'career')} alt="" width="88" height="88" loading="lazy" />
    <div class="timeline-copy">
      <h3 class="timeline-heading">{entry.href ? <a href={entry.href}>{entry.heading}</a> : entry.heading}</h3>
      {entry.subheading && <p class="timeline-organization">{entry.subheading}</p>}
      {entry.date && <p class="timeline-date">{entry.date}</p>}
      {entry.detail && <p class="timeline-detail">{entry.detail}</p>}
      {entry.body && <p class="timeline-body">{entry.body}</p>}
    </div>
    {NoteContent && <div class="timeline-note" lang={entry.personalNote?.locale}>
      <p class="timeline-note-label">{locale === 'en' ? 'Notes' : 'Notizen'}</p>
      <div class="timeline-note-content"><NoteContent /></div>
    </div>}
  </li>})}
</ol>
<style>
  :global(.markdown-reader) .career-timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    container-type: inline-size;
  }
  .career-timeline > .timeline-entry {
    --timeline-icon: 80px;
    display: grid;
    grid-template-columns: var(--timeline-icon) minmax(0, 1fr);
    align-items: start;
    column-gap: 26px;
    margin: 0;
    padding: 0 0 28px;
  }
  .career-timeline > .timeline-entry + .timeline-entry {
    padding-top: 28px;
    border-top: 1px solid #cdbd9e;
  }
  .career-timeline > .timeline-entry:last-child { padding-bottom: 0; }
  .timeline-entry > .timeline-icon {
    display: block;
    width: var(--timeline-icon);
    height: var(--timeline-icon);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    object-fit: contain;
    image-rendering: pixelated;
  }
  .timeline-entry > .timeline-copy { min-width: 0; padding-top: 3px; }
  .career-timeline .timeline-heading {
    margin: 0;
    font: 600 26px/1.12 var(--pixel);
    letter-spacing: -.015em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .career-timeline .timeline-heading a {
    color: inherit;
    text-decoration: none;
  }
  .career-timeline .timeline-heading a:hover {
    color: var(--reader-accent, #854b31);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .timeline-copy > .timeline-organization {
    margin: 6px 0 0;
    font-size: 20px;
    line-height: 1.25;
    color: #665344;
  }
  .timeline-copy > .timeline-date {
    margin: 9px 0 0;
    color: #756653;
    font-size: 16px;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }
  .timeline-copy > .timeline-detail,
  .timeline-copy > .timeline-body {
    margin: 13px 0 0;
    font-size: 18px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .timeline-entry > .timeline-note {
    grid-column: 2;
    min-width: 0;
    margin-top: 20px;
    padding: 2px 0 2px 16px;
    border-left: 2px solid #cdbd9e;
    color: #594a3c;
    font-size: 18px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .career-timeline .timeline-note-label {
    margin: 0 0 8px;
    color: #8a7259;
    font-size: 14px;
    line-height: 1.3;
  }
  .career-timeline .timeline-note-content :global(p),
  .career-timeline .timeline-note-content :global(ul),
  .career-timeline .timeline-note-content :global(ol) { margin: 0 0 .9em; }
  .career-timeline .timeline-note-content :global(ul),
  .career-timeline .timeline-note-content :global(ol) { padding-left: 1.3em; }
  .career-timeline .timeline-note-content :global(li) { margin-bottom: .35em; padding-left: .1em; }
  .career-timeline .timeline-note-content :global(li > p) { margin-bottom: .35em; }
  .career-timeline .timeline-note-content :global(:last-child) { margin-bottom: 0; }
  @container (max-width: 420px) {
    .career-timeline > .timeline-entry { --timeline-icon: 56px; column-gap: 18px; }
    .career-timeline .timeline-heading { font-size: 23px; }
    .timeline-copy > .timeline-organization { font-size: 18px; }
    .timeline-copy > .timeline-detail,
    .timeline-copy > .timeline-body { font-size: 17px; }
    .timeline-entry > .timeline-note { grid-column: 1 / -1; font-size: 17px; }
  }
  @container (max-width: 285px) {
    .career-timeline > .timeline-entry { --timeline-icon: 48px; column-gap: 14px; }
  }
</style>
