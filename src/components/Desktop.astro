---
import { render } from 'astro:content';
import { getApps, type App, type AppId } from '../lib/apps';
import { iconSrc } from '../lib/icons';
import { strings, otherLocale, localeHome, localizedAppHref, type Locale } from '../lib/i18n';
import Icon from './Icon.astro';
import Window from './Window.astro';
import TextLayout from './layouts/TextLayout.astro';
import ListLayout from './layouts/ListLayout.astro';
import GalleryLayout from './layouts/GalleryLayout.astro';
import MobileBoot from './MobileBoot.astro';
import WallpaperLife from './WallpaperLife.astro';
interface Props { initialApp?: AppId; locale?: Locale }
const { initialApp = 'welcome', locale = 'de' } = Astro.props;
const t = strings(locale);
const other = otherLocale(locale);
const apps = await getApps(locale);
const byId = new Map(apps.map(app => [app.id, app]));
const navApps = apps.filter(app => app.nav);
const desktopApps = apps.filter(app => app.id !== 'welcome' && (app.nav || app.deskIcon));
// Future files go to free slots in the wallpaper's sky, never over the skyline;
// explicit frontmatter coordinates keep the established arrangement stable.
const fallbackSlots = [
  [19, 47], [32, 8], [30, 24], [45, 10], [54, 20],
];
const occupied = desktopApps
  .filter(app => app.desktopX !== undefined && app.desktopY !== undefined)
  .map(app => [app.desktopX!, app.desktopY!]);
const desktopIcons = desktopApps.map((app, index) => {
  const slot = fallbackSlots.find(([x, y]) =>
    !occupied.some(([usedX, usedY]) => Math.abs(usedX - x) < 10 && Math.abs(usedY - y) < 19))
    ?? fallbackSlots[index % fallbackSlots.length];
  const x = app.desktopX ?? slot[0];
  const y = app.desktopY ?? slot[1];
  if (app.desktopX === undefined || app.desktopY === undefined) occupied.push([x, y]);
  return { app, x, y };
});
function ancestors(app: App): App[] {
  const result: App[] = [];
  let parent = app.parent ? byId.get(app.parent) : undefined;
  while (parent) {
    result.unshift(parent);
    parent = parent.parent ? byId.get(parent.parent) : undefined;
  }
  return result;
}
const windows = await Promise.all(apps.map(async app => {
  const children = apps.filter(child => child.parent === app.id);
  const items = app.data.items.flatMap(item => {
    if (!item.target) return [item];
    const target = byId.get(item.target);
    return target ? [{ ...item, href: target.href }] : [];
  });
  return { app, children, items, trail: ancestors(app), Content: (await render(app.entry)).Content };
}));
---
<main class="computer-stage" aria-label={t.computer} data-computer>
  <div class="scene-loader" data-scene-loader role="status" aria-live="polite"><span class="scene-loader-mark" aria-hidden="true"></span><span class="scene-loader-text" data-scene-loader-text>{t.sceneLoading}</span><span class="scene-loader-error" data-scene-error hidden>{t.sceneError}</span><button class="retro-button" type="button" data-scene-retry hidden>{t.sceneRetry}</button></div>
  <button class="view-toggle" type="button" data-view-toggle data-label-overview={t.viewComputer} data-label-screen={t.viewScreen} aria-pressed="false" hidden>{t.viewComputer}</button>
  <canvas class="computer-canvas" data-mac-canvas aria-hidden="true"></canvas>
  <div class="screen" data-screen data-initial-app={initialApp} data-site-title={t.siteTitle}>
    <picture class="wallpaper" aria-hidden="true">
      <source media="(max-width: 767px), (max-height: 500px)" srcset="/wallpapers/hamburg-mobile-v2.webp" />
      <img src="/wallpapers/hamburg-v2.webp" alt="" width="1600" height="1000" fetchpriority="high" draggable="false" />
    </picture>
    <WallpaperLife />
    <header class="menubar">
      <nav class="menu-left" aria-label={t.menu}>
        <a class="home-control" href={localeHome(locale)} data-target="welcome" aria-label={t.home}><span class="brand-mark" aria-hidden="true"></span><span class="menu-name">Silas</span><span class="mobile-home">{t.mobileHome}</span></a>
        <details class="system-menu"><summary>{t.file}</summary><div class="menu-popover">{navApps.map(app => <a href={app.href} data-target={app.id}>{app.title}</a>)}</div></details>
        <details class="system-menu"><summary>{t.view}</summary><div class="menu-popover"><button type="button" data-toggle-wallpaper>{t.changeWallpaper}</button><button type="button" data-close-all>{t.closeAll}</button><button type="button" data-view-computer data-label-overview={t.viewComputer} data-label-screen={t.viewScreen}>{t.viewComputer}</button></div></details>
      </nav>
      <div class="menu-status"><a class="lang-switch" href={localizedAppHref(initialApp, other)} hreflang={other} lang={other} data-lang={other} aria-label={t.switchLabel}>{other.toUpperCase()}</a><time data-clock>17:24</time><span class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="battery" aria-hidden="true"></span></div>
    </header>
    <nav class="icon-grid" aria-label={t.apps}>{desktopIcons.map(({ app, x, y }, i) => <div class="desk-item" style={`--desk-x:${x}%;--desk-y:${y}%;--i:${i}`}><Icon {...app} locale={locale} /></div>)}</nav>
    {windows.map(({ app, children, items, trail, Content }) => {
      const data = app.data;
      const empty = !app.entry.body?.trim() && !data.entries.length && !items.length && !children.length;
      return <Window locale={locale} id={app.id} title={app.title} width={app.width} height={app.height} x={data.x} y={data.y} visible={initialApp === app.id} welcome={app.id === 'welcome'} raw>
        {app.id === 'welcome' ? <div class="welcome-content"><Content />{items.length > 0 && <div class="welcome-actions">{items.map(item => item.href && <a class="retro-button" href={item.href} data-target={item.target}>{item.label}</a>)}</div>}</div> :
        <TextLayout locale={locale} title={app.title} description={data.description} date={data.date} trail={trail} empty={empty} folder={data.layout !== 'text'}>
          <Content />
          {data.entries.length > 0 && <ListLayout entries={data.entries} locale={locale} />}
          {items.length > 0 && <GalleryLayout items={items} locale={locale} />}
          {children.length > 0 && <nav class="content-index" aria-label={t.folderContents(app.title)}>
            {children.map(child => <a class="content-entry" href={child.href} data-target={child.id}>
              <img src={iconSrc(child.icon)} alt="" width="48" height="48" loading="lazy" />
              <span class="content-entry-copy"><span class="content-entry-title">{child.title}</span>{child.data.description && <span class="content-entry-description">{child.data.description}</span>}</span>
              <span class="content-entry-arrow" aria-hidden="true">↗</span>
            </a>)}
          </nav>}
        </TextLayout>}
      </Window>;
    })}
  </div>
  <MobileBoot locale={locale} />
  <dialog class="lightbox" aria-label={t.imageViewer}><button class="retro-button lightbox-close" type="button" data-lightbox-close aria-label={t.closeImage}>{t.close} ×</button><img alt="" /><iframe class="lightbox-video" title={t.video} allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen hidden></iframe></dialog>
</main>
<script src="../scripts/window-manager.js"></script>
<script src="../scripts/environment.js"></script>
